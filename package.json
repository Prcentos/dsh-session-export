{
  "name": "dsh-session-export",
  "version": "0.1.0",
  "description": "Export DSH sessions as portable Markdown and JSON transcripts so a conversation can move to another machine or resume in any other agent.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.mjs",
    "lib",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "docs",
    "icon.svg"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-0 <0.4.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": ">=0.2.0-0 <0.4.0-0",
    "@deepseek-ai/dsh-commands": ">=0.2.0-0 <0.4.0-0",
    "@deepseek-ai/schemastery": "^3.18.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-commands": {
      "optional": true
    }
  },
  "keywords": [
    "dsh-plugin",
    "dsh",
    "session",
    "export",
    "transcript",
    "markdown"
  ],
  "license": "MIT",
  "icon": "icon.svg"
}
